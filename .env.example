# Copy to .env before running `docker compose up` if you want to override the
# local defaults. Never commit a real secret.

# Local PostgreSQL container. Set a strong password before exposing the
# database to other machines on your LAN.
POSTGRES_PASSWORD=elibrary-dev-password

# Interface used to publish PostgreSQL. 127.0.0.1 keeps it local; 0.0.0.0
# allows other machines on the trusted network to connect.
POSTGRES_BIND_ADDRESS=0.0.0.0

# HS256 signing key for the development token endpoint. At least 32 bytes.
ELIBRARY_JWT_SECRET=replace-with-at-least-32-random-bytes

# Token issuer claim used by the embedded development issuer.
ELIBRARY_JWT_ISSUER=elibrary-local

# Comma-separated browser origins allowed to call the API. Enforced by the API's
# shared security configuration. Include every address you type in the browser,
# including the port: localhost, 127.0.0.1 or a LAN IP.
ELIBRARY_CORS_ALLOWED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088,http://192.168.68.108:8088

# In-process Caffeine cache for catalog reads. Keep the TTL short when running
# multiple API replicas: a write invalidates only the local instance immediately.
ELIBRARY_CACHE_TTL=30s
ELIBRARY_CACHE_MAX_SIZE=10000
